{
  "name": "asistente",
  "dependencies": {
    "hono": "^4.13.2",
    "vanui": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "private": true,
  "scripts": {
    "typecheck": "bun check",
