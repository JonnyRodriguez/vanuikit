{
  "version": "0.2",
  "language": "en",
  "$comment": [
    "Language gate: English is the canonical language of the codebase.",
    "Spanish is only allowed as a translation product: demo/shared/locales/es.json,",
    "fr.json, and the `es:` block of vanuikit/src/i18n.ts (cSpell:disable).",
    "NEVER add @cspell/dict-es-es (or any Spanish dictionary) here — the gate",
    "works precisely because Spanish words are 'unknown words'."
  ],
  "dictionaries": [
    "en_US",
    "software-terms",
    "typescript",
    "node",
    "npm",
    "bash",
    "html",
    "css"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.git/**",
    "**/.zcode/**",
    ".zed/**",
    "bun.lock",
    "demo/shared/locales/es.json",
    "demo/shared/locales/fr.json"
  ],
  "useGitignore": true,
  "enableGlobDot": true,
  "words": [
    "vanuikit",
    "vanjs",
    "unocss",
    "esbuild",
    "hono",
    "bunx",
    "tsx",
    "español",
    "français",
    "enregistrer",
    "guardar",
    "hoverable",
    "instrumenter",
    "fouc",
    "datepicker",
    "callees",
    "emojiish",
    "focusability",
    "focusables",
    "hrefs",
    "idxs",
    "notif",
    "uppercased",
    "vdom",
    "navigations",
    "keycap",
    "codemod",
    "preflights",
    "ollama",
    "openrouter",
    "sortability",
    "themable",
    "registrator",
    "sess",
    "morales",
    "elena",
    "zcodeignore",
    "asistente"
  ]
}
