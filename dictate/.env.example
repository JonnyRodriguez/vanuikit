# Copia este archivo a .env y pega tu key de AI Studio:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=pega_aqui_tu_key

# Modelo de transcripción (STT) — verificado en esta cuenta (2026-10):
#   gemini-3.5-transcribe-live → STT en streaming por Live API (TEXT)
GEMINI_STT_MODEL=models/gemini-3.5-transcribe-live

# Modelo del intérprete de comandos (Nivel 2) — verificado en esta cuenta:
#   gemini-3.5-flash-lite → clasifica comando/dictado (estable, cupo sano)
# Los demás modelos de Google tienen cupos muy bajos (503 por alta demanda).
# GEMINI_CMD_MODEL=models/gemini-3.5-flash-lite

# Límite de grabación por turno (ms). Por defecto 30000.
# VOICE_MAX_REC_MS=30000

# Dispositivo de entrada de arecord (opcional). Si se omite, usa el default.
# ARECORD_DEVICE=default
