# Copia este archivo a .env y pega tu key de AI Studio:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=pega_aqui_tu_key

# Modelo Live. Verificado en esta cuenta (2026-10):
#   gemini-3.8-live → Live general (65K tokens) — FUNCIONA
# Los ids tipo "-preview" / "-native-audio-dialog" NO existen para esta cuenta.
GEMINI_LIVE_MODEL=models/gemini-3.8-live

# Modelo de transcripción (STT) — verificado en esta cuenta:
#   gemini-3.5-transcribe-live → STT en streaming por Live API (TEXT)
GEMINI_STT_MODEL=models/gemini-3.5-transcribe-live
