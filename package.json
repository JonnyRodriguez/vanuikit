{
  "name": "vanui-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "vanui",
    "demo"
  ],
  "scripts": {
    "build:vanui": "npm run build --workspace=vanui",
    "build:demo": "npm run build --workspace=demo",
    "build": "npm run build:vanui && npm run build:demo",
    "dev": "npm run build && tsx demo/server/index.ts",
    "start": "tsx demo/server/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "hono": "^4.13.2",
    "qr-code-styling": "^1.9.0",
    "vanjs-core": "^1.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.8",
    "@unocss/core": "^66.7.5",
    "@unocss/preset-uno": "^66.7.5",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
