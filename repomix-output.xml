/**
 * Router — patrón SPA inspirado en store/web/src/router.ts.
 *
 * Navegación cliente entre pantallas sin recargar: pushState/popstate
 * + intercepción de clicks en <a>. Cada ruta se resuelve a un componente
 * (función que devuelve DOM reactivo). Un estado reactivo (`current`)
 * es renderizado en el contenedor #app.
 *
 * Uso:
 *   const router = new Router()
 *   router.add('/login', () => Login({ ... }))
 *   router.add('/', () => Home())
 *   router.setNotFound(() => NotFound())
 *   router.mount('#app')  // instala listeners y resuelve la ruta inicial
 *
 * La diferencia con el router del store: aquí los componentes reciben el
 * router (para navegar entre pantallas) y un estado global opcional.
 */
import van from "vanjs-core";

const { div } = van.tags;

/** Una ruta: path → fábrica de componente. */
export type Route = {
  path: string;
  component: () => Node;
};

export class Router {
  private routes: Route[] = [];
  private current = van.state<Node>(div("Cargando..."));
  private notFound: () => Node = () =>
    div({ class: "p-4 text-center" }, "404 - No encontrado");

  /** Registra una ruta. Devuelve el router para encadenar. */
  add(path: string, component: () => Node) {
    this.routes.push({ path, component });
    return this;
  }

  /** Componente para rutas sin match. */
  setNotFound(component: () => Node) {
    this.notFound = component;
    return this;
  }
  /**
   * Resuelve la ruta actual: busca match exacto; si no hay, usa notFound.
   * El resultado se escribe en el estado reactivo `current`.
   */
  private doResolve() {
    const currentPath = window.location.pathname || "/";
    const route = this.routes.find((r) => r.path === currentPath);
    this.current.val = route ? route.component() : this.notFound();
  }

  /**
   * Resuelve la ruta actual (público para reactividad externa).
   * Permite a app.ts forzar un re-resolve cuando el estado global cambia.
   */
  resolve() {
    this.doResolve();
  }

  /** Navega a `path` haciendo pushState + resolve. */
  navigate(path: string) {
    if (window.location.pathname !== path) {
      window.history.pushState({}, "", path);
      this.doResolve();
    }
  }

  /**
   * Instala listeners globales (popstate + click interception) y resuelve
   * la ruta inicial. Devuelve el nodo reactivo para montar con `van.add`.
   */
  start() {
    // back/forward
    window.addEventListener("popstate", () => this.doResolve());

    // Intercepta <a> internos para navegación SPA
    document.addEventListener("click", (e) => {
      const target = (e.target as HTMLElement).closest("a");
      if (
        target &&
        target.origin === window.location.origin &&
        !target.hasAttribute("data-native")
      ) {
        e.preventDefault();
        this.navigate(target.pathname);
      }
    });

    // Redirección raíz → /gateways (pantalla principal de la demo)
    if (window.location.pathname === "/") {
      window.history.replaceState({}, "", "/gateways");
    }

    this.doResolve();
    return () => this.current.val;
  }
}
