// server/controllers/auth.controller.ts
/**
 * AuthController — equivalente a auth.controller.php en CakePHP.
 *
 * Cada método es una acción (action) registrada en este router Hono.
 * El apiRouter.ts monta este router en /api/auth, por lo que las rutas
 * aquí definidas se resuelven como:
 *
 *   POST /api/auth/login     -> iniciar sesion
 *   POST /api/auth/register  -> crear cuenta
 *
 * La validacion usa Zod (schema), igual que el controlador del store.
 * La logica de negocio esta en AuthService (pattern Service — los
 * controladores son delgados, como en PHP).
 */
import { Hono } from "hono";
import { z } from "zod";
import { AuthService } from "../services/AuthService.js";
import type { LoginCredentials, RegisterData } from "../types.js";

const authController = new Hono();
const authService = new AuthService();

// --- Schemas Zod (validacion declarativa, como Laravel FormRequest) ---

const loginSchema = z.object({
  email: z.string().email(),
  password: z.string().min(1),
});

const registerSchema = z.object({
  name: z.string().min(1, "El nombre es requerido"),
  email: z.string().email(),
  password: z.string().min(1, "La contraseña es requerida"),
  confirm: z.string().min(1, "Confirma la contraseña"),
});

// --- Acciones (actions) ---

/**
 * login - POST /api/auth/login
 *
 *  200  { status: "ok" }
 *  401  { error: "Credenciales invalidas" }
 *  400  { error: "Datos invalidos", details: {...} }
 */
authController.post("/login", async (c) => {
  const body = await c.req.json();

  const parsed = loginSchema.safeParse(body);
  if (!parsed.success) {
    return c.json(
      { error: "Datos invalidos", details: parsed.error.flatten() },
      400,
    );
  }

  const result = await authService.login(parsed.data as LoginCredentials);

  if ("error" in result) {
    return c.json({ error: result.error }, 401);
  }

  return c.json({ status: "ok" });
});

/**
 * register - POST /api/auth/register
 *
 *  200  { status: "ok" }
 *  400  { error: "Datos invalidos" } | { error: "..." }
 *  409  { error: "El email ya esta registrado" }
 */
authController.post("/register", async (c) => {
  const body = await c.req.json();

  const parsed = registerSchema.safeParse(body);
  if (!parsed.success) {
    return c.json(
      { error: "Datos invalidos", details: parsed.error.flatten() },
      400,
    );
  }

  const result = await authService.register(parsed.data as RegisterData);

  if ("error" in result) {
    return c.json({ error: result.error }, 409);
  }

  return c.json({ status: "ok" });
});

export default authController;
</file>

<file path="demo/server/controllers/payment.controller.ts">
// server/controllers/payment.controller.ts
/**
 * PaymentController — equivalente a payment.controller.php en CakePHP.
 *
 * El apiRouter.ts monta este router en /api/payment, por lo que las rutas
 * aqui definidas se resuelven como:
 *
 *   GET  /api/payment/gateways  -> lista de pasarelas
 *   GET  /api/payment/params    -> parametros de recarga
 *   POST /api/payment/recharge  -> generar recarga (endpoint original: /payment/zpay_recargar)
 *
 * La logica de negocio esta en PaymentService.
 */
import { Hono } from "hono";
import { z } from "zod";
import { PaymentService } from "../services/PaymentService.js";

const paymentController = new Hono();
const paymentService = new PaymentService();

// --- Schema Zod para la recarga ---
const rechargeSchema = z.object({
  amount: z.string().min(1, "El monto es requerido"),
  gateway: z.record(z.string(), z.unknown()),
});

// --- Acciones (actions) ---

/**
 * gateways — GET /api/payment/gateways
 *
 *  200  { status: "ok", data: [...] }
 */
paymentController.get("/gateways", async (c) => {
  const gateways = paymentService.getGateways();
  return c.json({ status: "ok", data: gateways });
});

/**
 * params — GET /api/payment/params
 *
 *  200  { status: "ok", data: {...} }
 */
paymentController.get("/params", async (c) => {
  const params = paymentService.getParams();
  return c.json({ status: "ok", data: params });
});

/**
 * recharge — POST /api/payment/recharge
 *
 * Recibe { amount, gateway, ... } del formulario de recarga.
 * Delega a PaymentService.generateRecharge() que valida el monto
 * contra los limites configurados.
 *
 *  200  { status: "ok", data: { url: "https://..." } }
 *  400  { error: "Datos invalidos" } | { error: "..." }
 */
paymentController.post("/recharge", async (c) => {
  const body = await c.req.json();

  const parsed = rechargeSchema.safeParse(body);
  if (!parsed.success) {
    return c.json(
      { error: "Datos invalidos", details: parsed.error.flatten() },
      400,
    );
  }

  const result = await paymentService.generateRecharge(parsed.data);

  if (!result.success) {
    return c.json({ error: result.msg }, 400);
  }

  return c.json({ status: "ok", data: { url: result.url } });
});

export default paymentController;
</file>

