<file path="demo/server/services/AuthService.ts">
/**
 * AuthService — lógica de negocio de autenticación.
 *
 * Patrón Service (PHP): la regla de negocio vive aquí, fuera del controlador.
 * El controlador solo extrae los datos del request, llama al servicio y
 * formatea la respuesta. Así la lógica es reutilizable y testeable.
 *
 * NOTA: las contraseñas en texto plano son SOLO para el demo. En producción
 * se harían hash con bcrypt/argon2 y se compararían con hash_equals().
 */
import { users, FAIL_EMAIL } from "../data/index.js";
import type { ActionResult, LoginCredentials, RegisterData } from "../types.js";

export class AuthService {
  /**
   * Valida credenciales y devuelve el usuario (sin password) o un error.
   */
  async login(credentials: LoginCredentials): Promise<ActionResult> {
    const { email, password } = credentials;

    // Reproducción del mock original: fail@example.com siempre falla en login.
    if (email === FAIL_EMAIL) {
      return { error: "Credenciales inválidas para ese correo" };
    }

    const user = users.find((u) => u.email === email);
    if (!user || user.password !== password) {
      return { error: "Credenciales inválidas" };
    }

    return { success: true };
  }

  /**
   * Registra un nuevo usuario. Falla si el email ya existe.
   */
  async register(data: RegisterData): Promise<ActionResult> {
    const { name, email, password, confirm } = data;

    // Reproducción del mock original: fail@example.com ya existe.
    if (email === FAIL_EMAIL) {
      return { error: "Ya existe una cuenta con ese correo" };
    }

    // Verificar que el email no esté registrado.
    const existing = users.find((u) => u.email === email);
    if (existing) {
      return { error: "Ya existe una cuenta con ese correo" };
    }

    // Las contraseñas deben coincidir (la validación del form también lo
    // verifica en cliente, pero el backend nunca confía en el cliente).
    if (password !== confirm) {
      return { error: "Las contraseñas no coinciden" };
    }

    // Crear el usuario (en memoria — en producción iría a la BD).
    const newUser = {
      id: users.length + 1,
      name,
      email,
      password,
    };
    users.push(newUser);

    return { success: true };
  }
}
</file>

<file path="demo/server/services/PaymentService.ts">
/**
 * PaymentService — lógica de negocio de pagos/recargas.
 *
 * Patrón Service (PHP): la validación de montos, la generación de la URL
 * de recarga y la lógica de negocio del pago viven aquí, fuera del controlador.
 *
 * En una aplicación real este servicio se conectaría a una pasarela de pago
 * (PagaTodo, ZPay, etc.) y devolvería una URL real de checkout. Aquí genera
 * una URL mock que mantiene el formato del backend original.
 */
import { rechargeParams, gateways } from "../data/index.js";
import type { ActionResult, Gateway, RechargeParams, RechargeResult } from "../types.js";

export class PaymentService {
  /** Lista de pasarelas disponibles (para el selector del frontend). */
  getGateways(): Gateway[] {
    return gateways;
  }

  /** Parámetros de recarga (límites, moneda, center_id). */
  getParams(): RechargeParams {
    return rechargeParams;
  }

  /**
   * Genera una recarga: valida el monto y devuelve la URL de pago.
   *
   * @param data  Datos del formulario: { amount, gateway, ... }
   * @param data.amount     Monto a recargar (string del input number)
   * @param data.gateway    Pasarela seleccionada (incluye id, img, name)
   * @returns { success: true, url } | { success: false, msg }
   */
  async generateRecharge(data: Record<string, unknown>): Promise<RechargeResult> {
    const amount = parseFloat(data.amount as string);
    const min = parseFloat(rechargeParams.monto_min_recarga);
    const max = parseFloat(rechargeParams.monto_max_recarga);

    // Validación del monto (el frontend también la hace, pero el backend
    // NUNCA confía en la validación del cliente).
    if (Number.isNaN(amount)) {
      return { success: false, msg: "Ingresa un monto válido" };
    }
    if (amount < min) {
      return {
        success: false,
        msg: `El monto debe ser superior a ${min} ${rechargeParams.tipo}`,
      };
    }
    if (amount > max) {
      return {
        success: false,
        msg: `El monto debe ser inferior a ${max} ${rechargeParams.tipo}`,
      };
    }

    // Simular latencia del backend real (como el mock original: 800ms).
    await new Promise((resolve) => setTimeout(resolve, 800));

    // Generar una URL de recarga mock con el mismo formato que el original.
    const rechargeId = Math.floor(Math.random() * 100000);
    return {
      success: true,
      url: `https://plataforma.example/payments/recarga-${rechargeId}`,
    };
  }
}
</file>

<file path="demo/server/apiRouter.ts">
// server/apiRouter.ts
/**
 * apiRouter — escáner dinámico de controladores.
 *
 * Patrón: CakePHP / Laravel resource controllers. Cada archivo
 * `{resource}.controller.ts` en server/controllers/ define un sub-router
 * de Hono. El nombre del archivo determina el prefijo de URL:
 *
 *   auth.controller.ts     →  POST /api/auth/login, POST /api/auth/register
 *   payment.controller.ts  →  GET  /api/payment/gateways, POST /api/payment/recharge
 *
 * Equivalente al apiRouter.ts del paquete `store` (../store/api/src/apiRouter.ts).
 */
import fs from "node:fs";
import path from "node:path";
import { Hono } from "hono";

export async function createApiRouter(controllersDir: string): Promise<Hono> {
  const api = new Hono();

  if (!fs.existsSync(controllersDir)) {
    console.warn(`⚠ El directorio de controladores no existe: ${controllersDir}`);
    return api;
  }

  const files = fs.readdirSync(controllersDir);

  for (const file of files) {
    if (file.endsWith(".controller.ts") || file.endsWith(".controller.js")) {
      const routeName = file.replace(/\.controller\.(ts|js)$/, "");
      const routePath = "/" + routeName;
      const fullPath = path.join(controllersDir, file);

      try {
        const controllerModule = await import(fullPath);
        const controllerApp = controllerModule.default;

        if (controllerApp) {
          api.route(routePath, controllerApp);
          console.log("API] Ruta registrada: /api" + routePath + " <-- " + file);
        } else {
          console.warn("⚠  El controlador " + file + " no exporta un 'default' de Hono.");
        }
      } catch (error) {
        console.error("❌ Error al cargar el controlador " + file + ":", error);
      }
    }
  }

  return api;
}
</file>

<file path="demo/server/types.ts">
/**
 * Tipos compartidos entre controladores, servicios y datos.
 *
 * Mantener los contratos explícitos (interface/type) es un patrón PHP
 * (DTO — Data Transfer Object) que permite a los controladores validar
 * y a los servicios trabajar con tipos conocidos en lugar de `unknown`.
 */

/** Una pasarela de pago. */
export interface Gateway {
  id: string;
  name: string;
  img: string;
  currency?: string;
  /** Si existe, al seleccionarla el frontend redirige a esta URL (pago externo). */
  url?: string;
}

/** Parámetros de recarga enviados al frontend para el formulario. */
export interface RechargeParams {
  id: number;
  tipo: string;
  monto_min_recarga: string;
  monto_max_recarga: string;
  [key: string]: unknown;
}

/** Usuario (sin password). */
export interface User {
  id: number;
  name: string;
  email: string;
}

/** Credenciales de login. */
export interface LoginCredentials {
  email: string;
  password: string;
}

/** Datos de registro. */
export interface RegisterData {
  name: string;
  email: string;
  password: string;
  confirm: string;
}

/** Resultado de una operación que puede fallar. */
export type ActionResult = { error: string } | { success: true };

/** Resultado de la recarga: URL de pago o error. */
export interface RechargeResult {
  success: boolean;
  url?: string;
  msg?: string;
}
