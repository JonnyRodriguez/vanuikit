<file path="vanui/scripts/uno.js">
/**
 * Genera el CSS estático de la librería vanui, sin el runtime del CDN.
 *
 * Escanea los fuentes del paquete (vanui/src), extrae las clases de sus
 * componentes y las compila con @unocss/preset-uno -> dist/vanui.css
 *
 * Uso: bun run css  (o bun run build, que lo invoca)
 *
 * Dependencias (dev): @unocss/core y @unocss/preset-uno
 *
 * Tema: los colores, radios y sombras se resuelven con variables CSS `--vui-*`
 * definidas en :root (ver VUI_THEME). El consumidor re-tematiza la librería
 * sobreescribiendo esas variables en su propio CSS (cargado después de este).
 */
import { createGenerator } from "@unocss/core";
import presetUno from "@unocss/preset-uno";

// Escanea las clases de los componentes de la librería -> dist/vanui.css
const GLOB = ["src/**/*.ts"];
const OUT = "dist/vanui.css";

/** Reset mínimo (reemplaza el preflight que el preset trae por defecto y
 *  que el `preflights` propio del generador elimina). Sin `border-style:
 *  solid` los bordes con ancho (border-t-2, border-border…) se computan a
 *  0px y no se pintan — p. ej. el anillo del Spin quedaba invisible. */
const RESET = `
*, *::before, *::after {
  box-sizing: border-box;
  border-width: 0;
  border-style: solid;
  border-color: currentColor;
}
`.trim();

/** Variables del tema por defecto (mismos valores que las clases originales). */
const VUI_THEME = `
:root{
--vui-primary:#22c55e;
--vui-primary-hover:#16a34a;
--vui-primary-active:#15803d;
--vui-primary-fg:#ffffff;
--vui-primary-shadow:rgb(34 197 94 / .5);
--vui-secondary:#d1d5db;
--vui-secondary-hover:#9ca3af;
--vui-secondary-active:#6b7280;
--vui-secondary-fg:#1f2937;
--vui-accent:#2563eb;
--vui-accent-hover:#1d4ed8;
--vui-focus:#3b82f6;
--vui-background:#ffffff;
--vui-foreground:#111827;
--vui-foreground-soft:#374151;
--vui-muted:#6b7280;
--vui-border:#d1d5db;
--vui-overlay:rgb(0 0 0 / .5);
--vui-destructive:#dc2626;
--vui-radius-md:0.375rem;
--vui-radius-lg:0.5rem;
--vui-radius-2xl:1rem;
--vui-radius-full:9999px;
--vui-shadow-sm:0 1px 2px 0 rgb(0 0 0 / .05);
--vui-shadow-lg:0 10px 15px -3px rgb(0 0 0 / .1),0 4px 6px -4px rgb(0 0 0 / .1);
--vui-shadow-xl:0 20px 25px -5px rgb(0 0 0 / .1),0 8px 10px -6px rgb(0 0 0 / .1);
--vui-shadow-2xl:0 25px 50px -12px rgb(0 0 0 / .25);
}
`.trim();

/** Mapea las clases de color/radio/sombra a las variables del tema. */
const THEME = {
  colors: {
    primary: "var(--vui-primary)",
    "primary-hover": "var(--vui-primary-hover)",
    "primary-active": "var(--vui-primary-active)",
    "primary-fg": "var(--vui-primary-fg)",
    "primary-shadow": "var(--vui-primary-shadow)",
    secondary: "var(--vui-secondary)",
    "secondary-hover": "var(--vui-secondary-hover)",
    "secondary-active": "var(--vui-secondary-active)",
    "secondary-fg": "var(--vui-secondary-fg)",
    accent: "var(--vui-accent)",
    "accent-hover": "var(--vui-accent-hover)",
    focus: "var(--vui-focus)",
    background: "var(--vui-background)",
    foreground: "var(--vui-foreground)",
    "foreground-soft": "var(--vui-foreground-soft)",
    muted: "var(--vui-muted)",
    border: "var(--vui-border)",
    overlay: "var(--vui-overlay)",
    destructive: "var(--vui-destructive)",
  },
  borderRadius: {
    md: "var(--vui-radius-md)",
    lg: "var(--vui-radius-lg)",
    "2xl": "var(--vui-radius-2xl)",
    full: "var(--vui-radius-full)",
  },
  boxShadow: {
    sm: "var(--vui-shadow-sm)",
    lg: "var(--vui-shadow-lg)",
    xl: "var(--vui-shadow-xl)",
    "2xl": "var(--vui-shadow-2xl)",
  },
};

// Recolecta los archivos a escanear.
const files = [];
for (const pattern of GLOB) {
  for (const p of new Bun.Glob(pattern).scanSync(".")) files.push(p);
}

// El extractor de UnoCSS toma los tokens de clases de cualquier texto;
// concatenamos todo el código fuente.
const source = (
  await Promise.all(files.map((f) => Bun.file(f).text()))
).join("\n");

const generator = await createGenerator({
  // El theme va a nivel del generador, no dentro del preset: así las clases
  // de color custom, borderRadius y boxShadow resuelven a var(--vui-*).
  theme: THEME,
  presets: [presetUno()],
  preflights: [
    {
      layer: "preflights",
      getCSS: () => RESET,
    },
    {
      layer: "preflights",
      getCSS: () => VUI_THEME,
    },
  ],
});
const { css } = await generator.generate(source, { id: "vanui" });

await Bun.write(OUT, css);
console.log(
  `vanui.css generado (${files.length} archivos escaneados, ${css.length} bytes)`,
);
</file>

<file path="vanui/src/components/button.ts">
import van, { type ChildDom } from "vanjs-core";
import { cx } from "../util.js";

const BASE_CLASSES =
  "font-semibold w-full rounded-md transition duration-200 ease-in-out cursor-pointer border border-transparent";

/** Variantes de color del botón (tokens semánticos del tema). */
const VARIANT_CLASSES = {
  primary:
    "bg-primary text-primary-fg hover:bg-primary-hover active:bg-primary-active shadow-primary-shadow",
  secondary:
    "bg-secondary text-secondary-fg hover:bg-secondary-hover active:bg-secondary-active",
} as const;

/** Tamaños estándar (bootstrap/shadcn-like). */
const SIZE_CLASSES = {
  sm: "text-sm px-3 py-1.5",
  md: "text-base px-4 py-2",
  lg: "text-lg px-6 py-3",
} as const;

export type ButtonVariant = keyof typeof VARIANT_CLASSES;
export type ButtonSize = keyof typeof SIZE_CLASSES;

type ButtonProps = {
  variant?: ButtonVariant;
  size?: ButtonSize;
  class?: string;
  type?: "button" | "submit" | "reset";
  [key: string]: any;
};

/**
 * Botón unificado. `variant` y `size` son opcionales (defaults: primary, md).
 * `type` por defecto es "button" para no provocar submits accidentales:
 * pasa type: "submit" cuando vaya dentro de un Form.
 */
export const Button = (
  props: ButtonProps = {},
  ...children: ChildDom[]
) => {
  const {
    class: extra,
    type = "button",
    variant = "primary",
    size = "md",
    ...rest
  } = props;
  return van.tags.button(
    {
      ...rest,
      type,
      class: cx(
        BASE_CLASSES,
        VARIANT_CLASSES[variant],
        SIZE_CLASSES[size],
        extra,
      ),
    },
    ...children,
  );
};

// Wrappers de compatibilidad con la API anterior.
export const PrimaryButton = (props: ButtonProps = {}, ...children: ChildDom[]) =>
  Button({ ...props, variant: "primary" }, ...children);

export const SecondaryButton = (props: ButtonProps = {}, ...children: ChildDom[]) =>
  Button({ ...props, variant: "secondary" }, ...children);
</file>

<file path="vanui/src/components/modal.ts">
import van, { type ValidChildDomValue } from "vanjs-core";
import { SecondaryButton } from "./button.js";

/**
 * Contenido de una zona del modal: función que devuelve un hijo de VanJS
 * (se re-evalúa en cada render, sirve para contenido reactivo), o null
 * para ocultar la zona.
 */
export type ModalZone = (() => ValidChildDomValue) | null;

/** Contrato de set() / initialContent: cualquiera de las zonas, opcional. */
export type ModalContent = {
  header?: ModalZone | ValidChildDomValue;
  body?: ModalZone | ValidChildDomValue;
  footer?: ModalZone | ValidChildDomValue;
};

/**
 * Normaliza una zona: acepta funciones (reactivas), nodos/textos directos o
 * null/undefined (zona oculta).
 */
const zone = (v: unknown): ModalZone => {
  if (v === null || v === undefined) return null;
  return typeof v === "function" ? (v as ModalZone) : () => v as ValidChildDomValue;
};

/**
 * ModalBase — el ladrillo más básico: overlay + tres zonas (header, body,
 * footer) que se llenan con set() o con los setters individuales.
 */
export const ModalBase = (
  initialContent: ModalContent | null = null,
  initialVisible = false,
) => {
  const header = van.state<ModalZone>(null);
  const body = van.state<ModalZone>(null);
  const footer = van.state<ModalZone>(null);
  const isVisible = van.state(initialVisible);

  const setHeader = (newHeader: ModalZone | ValidChildDomValue = null) =>
    (header.val = zone(newHeader));
  const setBody = (newBody: ModalZone | ValidChildDomValue = null) =>
    (body.val = zone(newBody));
  const setFooter = (newFooter: ModalZone | ValidChildDomValue = null) =>
    (footer.val = zone(newFooter));

  const open = () => (isVisible.val = true);
  const close = () => (isVisible.val = false);

  /** Rellena por partes: set({ header, body, footer }, abrir). */
  const set = (input: ModalContent, show = false) => {
    if ("header" in input) setHeader(input.header);
    if ("body" in input) setBody(input.body);
    if ("footer" in input) setFooter(input.footer);
    if (show) open();
  };

  if (initialContent) set(initialContent);

  const div = van.tags.div;

  const render = () =>
    div(
      {
        class: () =>
          isVisible.val
            ? "fixed inset-0 flex items-center justify-center bg-overlay z-50 p-4"
            : "hidden",
        role: "dialog",
        "aria-modal": "true",
        onclick: (e) => e.target === e.currentTarget && close(),
      },
      div(
        {
          class: "bg-background rounded-lg shadow-xl p-6 w-full max-w-md",
          onclick: (e) => e.stopPropagation(),
        },
        () => (header.val ? header.val() : div()),
        () => (body.val ? body.val() : div()),
        () => (footer.val ? footer.val() : div()),
      ),
    );

  const mount = (container = document.body) => container.appendChild(render());

  return {
    open,
    close,
    setHeader,
    setBody,
    setFooter,
    set,
    mount,
    isVisible,
    render,
  };
};

// ---------------------------------------------------------------
// Modal — compuesto: ModalBase + título, botón de cierre y footer
// ---------------------------------------------------------------

export const ModalTitle = (title: string) =>
  van.tags.div({ class: "text-xl font-bold text-accent" }, title);

export const ModalClose = (onClose: () => void) =>
  van.tags.button(
    {
      type: "button",
      class:
        "text-2xl text-muted hover:text-foreground-soft bg-transparent border-none cursor-pointer p-0",
      "aria-label": "Cerrar",
      onclick: onClose,
    },
    "×",
  );

export const ModalHeaderWithTitleAndClose = (
  title: string,
  onClose: () => void,
) =>
  van.tags.div(
    { class: "flex justify-between items-center pb-3" },
    ModalTitle(title),
    ModalClose(onClose),
  );

export const ModalFooterWithCloseButton = (
  onClose: () => void,
  text = "Cerrar",
) =>
  van.tags.div(
    { class: "pt-3 flex justify-end gap-2" },
    SecondaryButton({ onclick: onClose }, text),
  );

export type ModalProps = ModalContent & { title?: string };

/**
 * Modal cómodo — construido sobre ModalBase: ya trae header con título +
 * botón de cierre y un footer con "Cerrar" por defecto.
 *
 *   const modal = Modal();
 *   modal.mount();
 *   modal.set({ title: "Hola", body: "Mundo" }, true); // abre
 *   modal.close();
 *
 * Se puede sobreescribir el footer pasando `footer` en set() (o null para
 * quitarlo, por ejemplo en un modal de carga).
 */
export const Modal = (
  initialContent: ModalProps | null = null,
  initialVisible = false,
) => {
  const title = van.state<string | undefined>(undefined);
  const header = () =>
    ModalHeaderWithTitleAndClose(title.val ?? "", () => modal.close());
  const footer = () => ModalFooterWithCloseButton(() => modal.close());

  const modal = ModalBase(
    { header, footer, ...initialContent },
    initialVisible,
  );

  const setTitle = (newTitle: string) => (title.val = newTitle);

  // Igual que ModalBase.set pero sin mutar el objeto del llamador:
  // completa el footer por defecto en una copia.
  const set = (input: ModalProps, show = false) => {
    const next: ModalContent = { ...input };
    if (!("footer" in next)) next.footer = footer;
    if (input.title !== undefined) setTitle(input.title);
    modal.set(next, show);
  };

  return { ...modal, setTitle, set };
};
</file>

<file path="vanui/src/components/nav.ts">
import van from "vanjs-core";
import { cx } from "../util.js";

export type NavLink = {
  href: string;
  label: string;
};

type NavProps = {
  /** Ruta del link actual; recibe la clase activa y aria-current. */
  current: string;
  class?: string;
};

/**
 * Navegación de links. Los items los define el consumidor; `current` marca
 * el activo (clase destacada + aria-current="page" para accesibilidad).
 * Trae su formato completo (layout + links); el consumidor ajusta con
 * `class` extra si lo necesita.
 */
export const Nav = (links: NavLink[], props: NavProps) => {
  const { current, class: extra } = props;
  const { nav, a } = van.tags;

  return nav(
    {
      class: cx(
        "flex flex-wrap gap-4 max-w-180 mx-auto mt-4 px-5",
        extra,
      ),
      "aria-label": "Principal",
    },
    links.map((link) => {
      const isCurrent = link.href === current;
      return a(
        {
          href: link.href,
          class: cx(
            "text-accent no-underline text-[0.9rem] hover:underline transition-colors",
            isCurrent && "font-bold",
          ),
          ...(isCurrent ? { "aria-current": "page" } : {}),
        },
        link.label,
      );
    }),
  );
};
</file>

