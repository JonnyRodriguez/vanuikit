<file path="gitupdate.sh">
#!/bin/bash
set -euo pipefail

readonly MSG=${1:-"update"}
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -n "$(git status --porcelain)" ]; then
  echo "Changes detected, committing and pulling..."
  git add "$SCRIPT_DIR/."
  git commit -m "$MSG"
