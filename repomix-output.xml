<file path="demo/app.ts">
/**
 * App — raíz de la SPA demo.
 *
 * Inspirado en store/web/src/app.ts: un Router + estado global + registro
 * declarativo de rutas. La diferencia: aquí el estado (gateways, params)
 * se carga ONCE desde el backend Hono y se comparte con las pantallas
 * via closures, no via permisos de usuario.
 *
 * Rutas:
 *   /            → redirige a /gateways
 *   /gateways    → flujo de recarga (lista de pasarelas → modal monto → QR)
 *   /login       → formulario de login
 *   /register    → formulario de registro
 *   /components  → catálogo de componentes
 */
import van from "vanjs-core";
import { Router } from "./router.js";
import { GatewaysScreen } from "./screens/gateways-screen.js";
import { LoginScreen } from "./screens/login-screen.js";
import { RegisterScreen } from "./screens/register-screen.js";
import { ComponentsScreen } from "./screens/components-screen.js";

const { div } = van.tags;
export const router = new Router();

// ---------------------------------------------------------------------------
// Tipos (re-exportados por app.js para uso de las pantallas).
// ---------------------------------------------------------------------------
export type Gateway = {
  id: string;
  name: string;
  img: string;
  currency?: string;
  url?: string;
};

export type RechargeParams = {
  id: number;
  tipo: string;
  monto_min_recarga: string;
  monto_max_recarga: string;
  [key: string]: unknown;
};

// ---------------------------------------------------------------------------
// Estado global: datos cargados una sola vez desde el backend.
// ---------------------------------------------------------------------------
export const paymentData = van.state<{
  gateways: Gateway[];
  params: RechargeParams;
} | null>(null);

// ---------------------------------------------------------------------------
// Navegación compartida (links usados en todas las pantallas).
// ---------------------------------------------------------------------------
export const NAV_LINKS = [
  { href: "/gateways", label: "Recarga" },
  { href: "/login", label: "Login" },
  { href: "/register", label: "Registro" },
  { href: "/components", label: "Componentes" },
];

// ---------------------------------------------------------------------------
// Carga de datos: gateways + params desde el backend Hono.
// ---------------------------------------------------------------------------
async function loadPaymentData() {
  try {
    const [gwRes, paramsRes] = await Promise.all([
      fetch("/api/payment/gateways"),
      fetch("/api/payment/params"),
    ]);

    if (!gwRes.ok || !paramsRes.ok) {
      throw new Error("No se pudieron cargar los datos del backend");
    }

    const [gwJson, paramsJson] = await Promise.all([
      gwRes.json(),
      paramsRes.json(),
    ]);

    paymentData.val = {
      gateways: gwJson.data,
      params: paramsJson.data,
    };
  } catch (err) {
    console.error("Error cargando datos de pago:", err);
  }
}

// ---------------------------------------------------------------------------
// Registro de rutas (patrón store/web: router.add(path, () => Component))
// ---------------------------------------------------------------------------
function registerRoutes() {
  router
    .add("/gateways", () =>
      // Reactivo: mientras paymentData carga, muestra el spinner;
      // una vez cargado, renderiza GatewaysScreen. VanJS re-evalúa
      // el div() cuando paymentData.val cambia (reactividad reactiva).
      div(() =>
        paymentData.val
          ? GatewaysScreen({ router, data: paymentData.val, links: NAV_LINKS })
          : div({ class: "p-4 text-center" }, "Cargando pasarelas..."),
      ),
    )
    .add("/login", () => LoginScreen({ router, links: NAV_LINKS }))
    .add("/register", () => RegisterScreen({ router, links: NAV_LINKS }))
    .add("/components", () =>
      ComponentsScreen({ router, links: NAV_LINKS }),
    )
    .setNotFound(
      () =>
        div(
          { class: "text-center p-8" },
          van.tags.h2({ class: "text-xl font-bold mb-2" }, "404"),
          van.tags.p({ class: "text-muted" }, "Página no encontrada"),
        ),
    );
}

// ---------------------------------------------------------------------------
// App — punto de montaje. Carga datos, registra rutas y devuelve el
// nodo reactivo que se monta en <div id="app"></div>.
// ---------------------------------------------------------------------------
export const App = () => {
  loadPaymentData();
  registerRoutes();
  return router.start();
};
</file>

