<file path="vanui/tests/button.test.ts">
import { describe, test, expect } from "bun:test";
import { Button, PrimaryButton, SecondaryButton } from "../src/components/button.js";

const mount = (node: HTMLElement) => {
  document.body.replaceChildren(node);
  return node;
};

describe("Button", () => {
  test("defaults: variant primary, size md, type button", () => {
    const btn = mount(Button({}, "Hola"));
    expect(btn.tagName).toBe("BUTTON");
    expect(btn.type).toBe("button");
    expect(btn.className).toContain("bg-primary");
    expect(btn.className).toContain("text-primary-fg");
    expect(btn.className).toContain("px-4");
    expect(btn.className).toContain("py-2");
    expect(btn.textContent).toBe("Hola");
  });

  test("variant secondary aplica las clases secundarias", () => {
    const btn = mount(Button({ variant: "secondary" }, "X"));
    expect(btn.className).toContain("bg-secondary");
    expect(btn.className).not.toContain("bg-primary");
  });

  test("size sm y lg cambian padding/texto", () => {
    const sm = mount(Button({ size: "sm" }));
    expect(sm.className).toContain("text-sm");
    expect(sm.className).toContain("px-3");
    const lg = mount(Button({ size: "lg" }));
    expect(lg.className).toContain("text-lg");
    expect(lg.className).toContain("px-6");
  });

  test("type submit se propaga al DOM", () => {
    const btn = mount(Button({ type: "submit" }));
    expect(btn.type).toBe("submit");
  });

  test("class extra se fusiona al final", () => {
    const btn = mount(Button({ class: "mi-clase" }));
    expect(btn.className).toContain("mi-clase");
  });

  test("wrappers de compatibilidad delegan en Button", () => {
    const p = mount(PrimaryButton({}, "P"));
    expect(p.className).toContain("bg-primary");
    const s = mount(SecondaryButton({}, "S"));
    expect(s.className).toContain("bg-secondary");
  });
});
</file>

<file path="vanui/tests/modal.test.ts">
import { describe, test, expect } from "bun:test";
import { Modal, ModalBase } from "../src/components/modal.js";

// VanJS actualiza los bindings en un microtask; hay que esperarlo.
const tick = () => new Promise((r) => setTimeout(r, 0));

describe("ModalBase", () => {
  test("oculto por defecto; open/close alternan la clase", async () => {
    const modal = ModalBase();
    modal.mount(document.body);
    const overlay = document.body.lastElementChild as HTMLElement;
    expect(overlay.className).toContain("hidden");

    modal.open();
    await tick();
    expect(overlay.className).toContain("bg-overlay");
    modal.close();
    await tick();
    expect(overlay.className).toContain("hidden");
  });

  test("set() rellena zonas y muestra con show=true", async () => {
    const modal = ModalBase();
    modal.mount(document.body);
    modal.set({ header: "Hola", body: "Mundo" }, true);
    await tick();
    const overlay = document.body.lastElementChild as HTMLElement;
    expect(overlay.textContent).toContain("Hola");
    expect(overlay.textContent).toContain("Mundo");
    expect(overlay.className).toContain("bg-overlay");
  });

  test("zona footer: null la oculta", async () => {
    const modal = ModalBase();
    modal.mount(document.body);
    modal.set({ footer: null, body: "solo cuerpo" }, true);
    await tick();
    const overlay = document.body.lastElementChild as HTMLElement;
    expect(overlay.textContent).not.toContain("Cerrar");
  });
});

describe("Modal", () => {
  test("trae título, botón de cierre y footer con Cerrar", async () => {
    const modal = Modal();
    modal.mount(document.body);
    modal.set({ title: "Editar", body: "contenido" }, true);
    await tick();
    const overlay = document.body.lastElementChild as HTMLElement;
    expect(overlay.textContent).toContain("Editar");
    expect(overlay.textContent).toContain("contenido");
    expect(overlay.textContent).toContain("Cerrar");

    const closeBtn = overlay.querySelector('[aria-label="Cerrar"]') as HTMLElement;
    closeBtn.click();
    expect(modal.isVisible.val).toBe(false);
  });
});
</file>

<file path="vanui/tests/nav.test.ts">
import { describe, test, expect } from "bun:test";
import { Nav } from "../src/components/nav.js";

const LINKS = [
  { href: "./index.html", label: "Recarga" },
  { href: "./login.html", label: "Login" },
  { href: "./register.html", label: "Registro" },
  { href: "./components.html", label: "Componentes" },
];

describe("Nav", () => {
  test("renderiza un link por item, con href y label", () => {
    const nav = Nav(LINKS, { current: "./index.html" });
    document.body.replaceChildren(nav);
    const anchors = [...document.body.querySelectorAll("a")];
    expect(anchors).toHaveLength(4);
    expect(anchors[1].getAttribute("href")).toBe("./login.html");
    expect(anchors[1].textContent).toBe("Login");
  });

  test("marca el link actual con aria-current=page y clase activa", () => {
    const nav = Nav(LINKS, { current: "./register.html" });
    document.body.replaceChildren(nav);
    const active = document.body.querySelector(
      '[aria-current="page"]',
    ) as HTMLElement;
    expect(active).not.toBeNull();
    expect(active.textContent).toBe("Registro");
    expect(active.className).toContain("text-accent");
    expect(active.className).toContain("font-bold");
  });

  test("solo un link lleva aria-current", () => {
    const nav = Nav(LINKS, { current: "./index.html" });
    document.body.replaceChildren(nav);
    const actives = document.body.querySelectorAll('[aria-current="page"]');
    expect(actives).toHaveLength(1);
  });
});
