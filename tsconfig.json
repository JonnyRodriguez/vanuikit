{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "vanui": ["./vanui/src/index.ts"],
      "vanui/*": ["./vanui/src/*"]
    },
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["vanui/src/**/*", "demo/**/*"]
}
