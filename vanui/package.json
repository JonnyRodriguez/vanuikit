{
  "name": "vanui",
  "version": "0.1.0",
  "description": "Librería universal de componentes VanJS: botones, campos, formularios, modal, spinner, validación, router y auth como base de SPA",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./styles.css": "./dist/vanui.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run css && npm run bundle && npm run bundle:server && npm run types",
    "bundle": "esbuild src/index.ts --outdir=dist --bundle --format=esm --external:vanjs-core",
    "bundle:server": "esbuild src/server/index.ts --outfile=dist/server/index.js --bundle --format=esm --platform=node --external:hono --external:vanjs-core",
    "types": "tsc --project tsconfig.build.json",
    "css": "node scripts/uno.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "hono": ">=4.0.0",
    "vanjs-core": ">=1.6.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.6",
    "@types/node": "^22.13.10",
    "@unocss/core": "^66.7.5",
    "@unocss/preset-uno": "^66.7.5",
    "esbuild": "^0.25.0",
    "hono": "^4.13.2",
    "typescript": "^5.8.2",
    "vanjs-core": "^1.6.0"
  }
}
