{
  "name": "vanuikit",
  "version": "0.4.0",
  "description": "Universal VanJS component library: buttons, fields, forms, modal, spinner, validation, router and auth as an SPA foundation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonnyRodriguez/vanuikit.git"
  },
  "keywords": [
    "vanjs",
    "van",
    "ui",
    "components",
    "reactive",
    "typescript",
    "frontend",
    "hono",
    "documentation"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./styles.css": "./dist/vanuikit.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run css && npm run bundle && npm run bundle:server && npm run types",
    "bundle": "esbuild src/index.ts --outdir=dist --bundle --format=esm --external:vanjs-core",
    "bundle:server": "esbuild src/server/index.ts --outfile=dist/server/index.js --bundle --format=esm --platform=node --external:hono --external:vanjs-core",
    "types": "tsc --project tsconfig.build.json",
    "css": "node scripts/uno.js",
    "typecheck": "tsc --noEmit",
    "check:van": "bun scripts/check-van-rules.ts",
    "size": "bun scripts/size-check.mjs",
    "test": "bun test"
  },
  "peerDependencies": {
    "hono": ">=4.0.0",
    "vanjs-core": ">=1.6.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.6",
    "@types/node": "^22.13.10",
    "@unocss/core": "^66.7.5",
    "@unocss/preset-uno": "^66.7.5",
    "esbuild": "^0.25.0",
    "hono": "^4.13.2",
    "typescript": "^5.8.2",
    "vanjs-core": "^1.6.0"
  }
}
